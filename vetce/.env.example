# PerioVive CE — backend environment variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env  (Unix)
#   Copy-Item .env.example .env  (PowerShell)

# PostgreSQL connection string. The default below points at the local Docker
# instance defined in docker-compose.yml — change for production.
DATABASE_URL=postgresql+psycopg://vetce:vetce_dev@localhost:5432/vetce

# Logging verbosity. Use DEBUG locally for full request/scrape traces;
# INFO is the production default.
LOG_LEVEL=INFO

# User-Agent string sent on every outbound HTTP request to providers.
# Include contact info so providers can reach out if our traffic is a problem.
USER_AGENT=VetCEBot/0.1 (https://periovive.com; contact@periovive.com)

# Scheduler mode controls APScheduler timing:
#   prod  — read per-source cron from the sources table (default; e.g. "0 3 * * *")
#   dev   — fire every 5 minutes, staggered, for fast iteration
SCHEDULER_MODE=prod

# Admin dashboard password. Set this to a long random value before deploying.
# The /admin section of the site is gated by this password.
ADMIN_PASSWORD=garvii

# Environment: "dev" for local, "production" for deployed instances
ENVIRONMENT=dev

# Frontend URL for CORS in production. Leave blank for local dev.
FRONTEND_URL=