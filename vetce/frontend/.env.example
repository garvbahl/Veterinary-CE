# PerioVive CE — frontend environment variables
#
# Copy this file to .env.local and adjust if needed:
#   cp .env.example .env.local

# Base URL of the backend API. Default is the local backend running on port 8000.
# In production this points at the deployed backend (Railway/Render/etc).
#
# NOTE: must be prefixed with NEXT_PUBLIC_ to be exposed to client-side code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000